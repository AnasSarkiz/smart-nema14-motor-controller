{
  "name": "@tsci/AnasSarkiz.smart-nema14-motor-controller--01a0fd9b",
  "version": "0.0.51-alpha.0",
  "description": "RP2040 NEMA14 prototype: separate 15V USB-PD motor and computer USB-C data ports; qualification in progress",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "validate:imports": "node scripts/check-critical-import-pins.mjs",
    "build": "bun run validate:imports && tsci build index.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs",
    "snapshot": "bun run validate:imports && tsci snapshot index.circuit.tsx",
    "format": "biome format --write index.circuit.tsx routing-review.circuit.tsx assembly.circuit.tsx mounted-assembly.circuit.tsx controller-preview.circuit.tsx src scripts mechanical/viewer.js mechanical/design-constraints.json package.json tsconfig.json tscircuit.config.json biome.json",
    "format:check": "biome format index.circuit.tsx routing-review.circuit.tsx assembly.circuit.tsx mounted-assembly.circuit.tsx controller-preview.circuit.tsx src scripts mechanical/viewer.js mechanical/design-constraints.json package.json tsconfig.json tscircuit.config.json biome.json",
    "typecheck": "tsc --noEmit",
    "preview:schematic": "bun run validate:imports && tsci build index.circuit.tsx --disable-pcb --schematic-svgs --schematic-png && node scripts/render-schematic-sheets.mjs",
    "test:draft": "node scripts/check-draft-connectivity.mjs",
    "preview:imports": "tsci build scripts/import-audit.circuit.tsx --pcb-png --pcb-svgs",
    "test:imports": "node scripts/check-released-imports.mjs",
    "test:usb-imports": "node scripts/check-usb-imports.mjs",
    "preview:usb-imports": "tsci build scripts/usb-import-audit.circuit.tsx --pcb-png --pcb-svgs",
    "preview:assembly": "tsci build assembly.circuit.tsx --3d-png --glbs",
    "test:assembly": "node scripts/check-mechanical-assembly.mjs",
    "test:usb-model": ".mechanical-venv/bin/python mechanical/check-usb-connector-model.py",
    "preview:viewer": "bun build mechanical/viewer.js --target browser --minify --outfile mechanical/viewer.bundle.js && .mechanical-venv/bin/python mechanical/build-viewer.py",
    "preview:controller": "tsci build controller-preview.circuit.tsx --pcb-png --pcb-svgs --3d-png --glbs",
    "test:all-imports": "node scripts/check-all-imports.mjs",
    "test:usb-footprint": "node scripts/check-usb-manufacturer-footprint.mjs",
    "test:motor-footprint": "node scripts/check-motor-connector-footprint.mjs",
    "test:symbol-rotation": "node scripts/check-imported-symbol-rotation.mjs",
    "bom:review": "node scripts/generate-review-bom.mjs",
    "preview:mounted": "tsci build mounted-assembly.circuit.tsx --pcb-png --pcb-svgs --3d-png --glbs",
    "test:front-carrier": ".mechanical-venv/bin/python mechanical/check-front-carrier.py",
    "test:bom-catalog": "node scripts/check-bom-catalog.mjs",
    "bom:table": "node scripts/generate-bom-table.mjs",
    "test:power-model": ".mechanical-venv/bin/python mechanical/check-tps26600-model.py",
    "test:power-imports": "node scripts/check-power-imports.mjs",
    "test:power-corners": "python3 scripts/check-power-corners.py",
    "cloud:setup": "bash scripts/cloud-setup.sh",
    "cloud:smoke": "bash scripts/cloud-smoke.sh",
    "cloud:route": "python3 scripts/run-cloud-routing.py",
    "test:schematic-notes": "node scripts/check-schematic-notes.mjs",
    "test:standard-usb": "node scripts/check-standard-usb-schematic.mjs",
    "test:stusb4500-readback": "node scripts/test-stusb4500-readback.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tscircuit/capacity-autorouter": "0.0.962",
    "@tscircuit/checks": "0.0.242",
    "@tscircuit/cli": "0.1.2257",
    "@tscircuit/core": "0.0.2107",
    "@tscircuit/modelprinter": "0.0.14",
    "@tscircuit/props": "0.0.695",
    "@tscircuit/runframe": "0.0.2925",
    "circuit-json": "0.0.520",
    "circuit-to-svg": "0.0.445",
    "dsn-converter": "0.0.92",
    "dsnts": "0.1.12",
    "easyeda": "0.0.374",
    "sharp": "0.32.6",
    "tscircuit": "0.0.2757",
    "typescript": "5.9.3"
  },
  "author": "AnasSarkiz",
  "dependencies": {
    "@tsci/tscircuit.standard-jst-programmer": "0.8.0"
  },
  "private": true,
  "overrides": {
    "@tscircuit/core": "0.0.2107",
    "@tscircuit/capacity-autorouter": "0.0.962",
    "@tscircuit/props": "0.0.695",
    "@tscircuit/checks": "0.0.242",
    "circuit-json": "0.0.520"
  },
  "packageManager": "bun@1.3.9"
}
